# Public URL of the site (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://antarfoods.com

# Google Search Console: the content="…" value of the HTML-tag verification method (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (optional; only loads in production builds)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin login
ADMIN_PASSWORD=change-me
# Random string of 32+ characters used to sign the admin session cookie
ADMIN_SESSION_SECRET=

# Production storage: when these are set, the admin commits changes to GitHub
# (Amplify then rebuilds). When unset, the admin writes to the local files instead.
# Fine-grained token with "Contents: Read and write" on this repository only.
GITHUB_TOKEN=
# "owner/repo", e.g. Mirailit-Ltd/antar-foods-portfolio (not the full URL)
GITHUB_REPO=owner/repo
GITHUB_BRANCH="main"

# Contact form email (any SMTP provider: Brevo, Amazon SES, Gmail app password, your mail host)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="miraidev25@gmail.com"
SMTP_PASS="qnfx ccfl yfnb yzcl"
# Sender shown on the email; must be an address your SMTP provider lets you send from
SMTP_FROM="Antar Foods <no-reply@antarfoods.com>"
# Where contact messages are delivered (defaults to antar.foods.ltd@gmail.com)
CONTACT_TO_EMAIL="miraidev25@gmail.com"
